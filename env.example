# Copy to .env and fill in. Real environment variables override this file.
# .env is gitignored: it holds the shared dev DB password. Never commit it.

# ── PostgreSQL (shared Supabase dev DB) ───────────────────────────────────────
# The same connection string as POSTGRES_DSN in the git2 repo. Our tables live
# in the ci_svc schema, created by migrations in the git2 repo.
POSTGRES_DSN=

# Optional: a throwaway database for the Postgres integration tests. Leave it
# empty to skip them. Never point it at the shared dev DB.
TEST_POSTGRES_DSN=

# ── Redis (shared by all git2 services) ───────────────────────────────────────
# Only ci-svc talks to Redis, never the runner. Every key and channel we use
# starts with "ci:". The devcontainer overrides the address to redis:6379.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ── Docker (where job containers run) ─────────────────────────────────────────
# Unset means the local daemon. The devcontainer always uses its own
# Docker-in-Docker service (tcp://docker:2375), whatever is set here.
# DOCKER_HOST=unix:///var/run/docker.sock
