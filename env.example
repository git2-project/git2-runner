# Copy to .env and fill in. Real environment variables override this file.
# .env is gitignored: it holds the shared dev DB password. Never commit it.

# ── PostgreSQL (shared Supabase dev DB) ───────────────────────────────────────
# The same connection string as POSTGRES_DSN in the git2 repo. Our tables live
# in the ci_svc schema, created by migrations in the git2 repo.
# Until the shared DB has the ci_svc schema (the migration must be merged in
# git2 first), the devcontainer's test database works too:
#   postgres://git2:git2@postgres:5432/git2_test?sslmode=disable
POSTGRES_DSN=
POSTGRES_MAX_CONNS=10

# Throwaway database for the Postgres integration tests. The devcontainer sets
# it to its own postgres service. Never point it at the shared dev DB.
TEST_POSTGRES_DSN=

# ── Redis (shared by all git2 services) ───────────────────────────────────────
# Only ci-svc talks to Redis, never the runner. Every key and channel we use
# starts with "ci:". The devcontainer overrides the address to redis:6379.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ── ci-svc ────────────────────────────────────────────────────────────────────
# 32 random bytes in base64: `openssl rand -base64 32`. Every CI secret is
# encrypted with it. Losing it makes every stored CI secret unreadable, so it
# belongs in the instance's backed-up secrets, never in git. Use your own key
# in development; ci-svc refuses to start if the stored secrets were
# encrypted with a different key.
GIT2_CI_SECRETS_KEY=
# Internal port (PipelineService, RunnerAdminService, SecretService).
GIT2_CISVC_GRPC_ADDR=:9090
# Runner port (RunnerService). Without the two TLS files it serves plaintext:
# development only, or behind a proxy that terminates TLS.
GIT2_CISVC_RUNNER_ADDR=:9091
GIT2_CISVC_RUNNER_TLS_CERT=
GIT2_CISVC_RUNNER_TLS_KEY=
# true enables gRPC reflection (grpcurl) and GIT2_CISVC_DEV_CONFIG_DIR. Never
# in production.
GIT2_CISVC_DEV=true
# Dev only: read .git2-ci.yml from <dir>/<repository_id>/.git2-ci.yml instead
# of git-svc, which cannot serve files yet (assumption A-03).
GIT2_CISVC_DEV_CONFIG_DIR=
GIT2_CISVC_LOG_LEVEL=info

# ── git2-runner ───────────────────────────────────────────────────────────────
# Where `git2-runner register` writes and `git2-runner run` reads the config
# file with the runner token.
GIT2_RUNNER_CONFIG=/workspace/.data/runner.json

# ── Docker (where job containers run) ─────────────────────────────────────────
# Unset means the local daemon. The devcontainer always uses its own
# Docker-in-Docker service (tcp://docker:2375), whatever is set here.
# DOCKER_HOST=unix:///var/run/docker.sock
