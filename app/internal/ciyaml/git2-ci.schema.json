{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/git2-project/git2-runner/blob/main/app/internal/ciyaml/git2-ci.schema.json",
  "title": ".git2-ci.yml v0",
  "description": "The pipeline of a git2 repository. Reference: docs/api/ci-yaml.md in git2-runner. Some rules (a job's stage must be listed in stages, durations within their limits, at least one job) are only checked by ci-svc.",
  "type": "object",
  "properties": {
    "stages": {
      "description": "Stages in the order they run. Defaults to [build, test, deploy].",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "variables": {
      "description": "Environment variables for every job.",
      "$ref": "#/$defs/variables"
    }
  },
  "patternProperties": {
    "^\\.": {
      "description": "A template for YAML anchors. Not a job."
    }
  },
  "propertyNames": {
    "anyOf": [{ "pattern": "^\\." }, { "$ref": "#/$defs/name" }],
    "not": {
      "enum": ["default", "include", "workflow", "image", "services", "before_script", "after_script", "cache", "pages"]
    }
  },
  "additionalProperties": { "$ref": "#/$defs/job" },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,63}$"
    },
    "duration": {
      "description": "Whole days, hours, minutes and seconds, in that order: 90s, 10m, 1h30m, 7d.",
      "type": "string",
      "pattern": "^(?:[0-9]+d)?(?:[0-9]+h)?(?:[0-9]+m)?(?:[0-9]+s)?$",
      "minLength": 2
    },
    "path": {
      "description": "A path relative to the job's working directory. Glob patterns are allowed.",
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "not": { "pattern": "^/|^\\.\\.(/|$)" }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/path" }
    },
    "variables": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,99}$",
        "not": { "pattern": "^(CI_|GIT2_)" }
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "job": {
      "type": "object",
      "required": ["image", "script"],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "description": "The job's stage. Defaults to test.",
          "$ref": "#/$defs/name"
        },
        "image": {
          "description": "Container image the job runs in, for example golang:1.26.",
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^\\S+$"
        },
        "script": {
          "description": "Shell commands, run in order with /bin/sh. The job fails at the first one that fails.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": ["string", "number", "boolean"], "minLength": 1 }
            }
          ]
        },
        "variables": {
          "description": "Environment variables for this job. They override the file's variables.",
          "$ref": "#/$defs/variables"
        },
        "tags": {
          "description": "The job runs only on a runner that has every one of these labels.",
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tag" }
        },
        "timeout": {
          "description": "Stop the job after this long. 10s to 1d; defaults to 1h.",
          "$ref": "#/$defs/duration"
        },
        "artifacts": {
          "description": "Files to keep after the job ends.",
          "type": "object",
          "required": ["paths"],
          "additionalProperties": false,
          "properties": {
            "paths": { "$ref": "#/$defs/paths" },
            "expire_in": {
              "description": "How long to keep them. 1h to 365d; defaults to 30d.",
              "$ref": "#/$defs/duration"
            }
          }
        },
        "cache": {
          "description": "Files to keep between runs of the job (used from WBS-10.6).",
          "type": "object",
          "required": ["paths"],
          "additionalProperties": false,
          "properties": {
            "key": { "$ref": "#/$defs/tag" },
            "paths": { "$ref": "#/$defs/paths" }
          }
        }
      }
    }
  }
}
